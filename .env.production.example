# Production / Vercel — copy these into Vercel → Project → Settings → Environment Variables
# See docs/PHASE_1_DEPLOY.md for full runbook
#
# Vercel project settings:
#   Root Directory = frontend
#   (install/build commands come from frontend/vercel.json)

# Do NOT set NODE_ENV in Vercel — Vercel sets it automatically.
# Setting NODE_ENV=production during install skips needed build packages.
BASE_URL=https://trusttap.commiters.com

# PostgreSQL (Neon / Supabase) — use connection pooling URL if provider offers it
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate: openssl rand -base64 48 (or similar long random string)
ADMIN_SECRET=

# Commiters SMTP — backup / archive low-rating owner alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@commiters.com
SMTP_PASS=
SMTP_FROM=TrustTap <noreply@commiters.com>

# Primary owner alerts (Phase 1) — Twilio WhatsApp and/or SMS
# Start with ALERT_PHONE_MODE=log if Twilio is not ready yet, then switch to twilio
ALERT_PHONE_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional rate-limit overrides (defaults in code are fine for pilot)
# RATE_LIMIT_PAGE_VIEWS_MAX=60
# RATE_LIMIT_FEEDBACK_MAX=10
# COMMENT_MAX_CHARS=1000
