# Production / Vercel — copy these into Vercel → Project → Settings → Environment Variables
# See docs/PHASE_1_DEPLOY.md for full runbook

NODE_ENV=production
BASE_URL=https://feedbackflow.commiters.in

# PostgreSQL (Neon / Supabase) — use connection pooling URL if provider offers it
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate: openssl rand -base64 48 (or similar long random string)
ADMIN_SECRET=

# Commiters SMTP — required for low-rating owner alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@commiters.in
SMTP_PASS=
SMTP_FROM=TrustTap <noreply@commiters.in>

# Primary owner alerts (Phase 1) — configure Twilio for production
ALERT_PHONE_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional rate-limit overrides (defaults in code are fine for pilot)
# RATE_LIMIT_PAGE_VIEWS_MAX=60
# RATE_LIMIT_FEEDBACK_MAX=10
# COMMENT_MAX_CHARS=1000
