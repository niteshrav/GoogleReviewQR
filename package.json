{
  "name": "trusttap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cd frontend && next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate --schema=database/schema.prisma && cd frontend && next build",
    "start": "cd frontend && next start",
    "lint": "cd frontend && next lint",
    "deploy:check": "npm test && npm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:ci": "npm run test:unit && npm run build && npm run test:e2e",
    "postinstall": "prisma generate --schema=database/schema.prisma",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=database/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=database/schema.prisma",
    "db:push": "prisma db push --schema=database/schema.prisma",
    "db:studio": "prisma studio --schema=database/schema.prisma",
    "db:seed": "tsx backend/scripts/seed-pilot.ts",
    "hooks:setup": "bash scripts/setup-git-hooks.sh",
    "prepare": "bash scripts/setup-git-hooks.sh || true"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@prisma/client": "^6.11.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.3.5",
    "framer-motion": "^12.42.2",
    "next": "^15.3.5",
    "nodemailer": "^9.0.3",
    "prisma": "^6.11.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
