# App
NODE_ENV=development
# Phone QR testing: set to your PC Wi-Fi IP, e.g. http://192.168.1.4:3000
# (localhost will fail on phones — localhost means the phone itself)
BASE_URL=http://localhost:3000

# Database (PostgreSQL — Supabase or Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Admin (minimal /admin protection)
ADMIN_SECRET=change-me-to-a-long-random-string

# SMTP (existing Commiters mail) — backup / archive alerts
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@commiters.com
SMTP_PASS=
SMTP_FROM="TrustTap <noreply@commiters.com>"

# Rate limits (optional overrides)
RATE_LIMIT_PAGE_VIEWS_MAX=60
RATE_LIMIT_PAGE_VIEWS_WINDOW_SECONDS=3600
RATE_LIMIT_FEEDBACK_MAX=10
RATE_LIMIT_FEEDBACK_WINDOW_SECONDS=3600

# Validation (optional overrides)
COMMENT_MAX_CHARS=1000

# Owner alerts — primary phone channel (Phase 1)
# log = dev (console); twilio = production WhatsApp/SMS
ALERT_PHONE_MODE=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
